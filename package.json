{
  "name": "mongo-studio",
  "version": "0.0.3",
  "description": "A free open-source alternative for Studio3T.",
  "author": "RisingMedia Solutions <shloooo@users.noreply.github.com>",
  "main": "src/main/main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite --config vite.config.js",
    "dev:electron": "electron . --serve --render-dev",
    "build:renderer": "vite build --config vite.config.js",
    "generate:gitinfo": "node scripts/generateGitInfo.js",
    "start": "yarn build:renderer && electron . --serve",
    "electron": "electron . --serve",
    "dist": "yarn generate:gitinfo && yarn build:renderer && electron-builder"
  },
  "dependencies": {
    "bson": "^7.3.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "mongodb": "^7.5.0",
    "react-i18next": "^17.0.11",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "dev.risingmedia.mongostudio",
    "productName": "MongoStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "src/preload/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "maintainer": "RisingMedia Solutions <shloooo@users.noreply.github.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "shloooo",
      "repo": "MongoStudio"
    }
  }
}
