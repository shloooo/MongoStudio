{
  "name": "mongo-studio",
  "version": "1.3.0",
  "description": "A free open-source alternative for Studio3T.",
  "author": "RisingMedia Solutions <shloooo@users.noreply.github.com>",
  "main": "dist-main/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --config vite.config.js",
    "dev:electron": "yarn build:main && electron . --serve --render-dev",
    "build:renderer": "vite build --config vite.config.js",
    "build:main": "tsc -p tsconfig.main.json",
    "generate:gitinfo": "node scripts/generateGitInfo.js",
    "start": "yarn build:main && yarn build:renderer && electron . --serve",
    "electron": "electron . --serve",
    "dist": "yarn generate:gitinfo && yarn build:main && yarn build:renderer && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.12",
    "@uiw/react-codemirror": "^4.25.11",
    "bson": "^7.3.3",
    "codemirror": "^6.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "mongodb": "^7.6.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.11",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "dev.risingmedia.mongostudio",
    "productName": "MongoStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-main/**",
      "src/main/gitInfo.generated.json",
      "src/preload/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "maintainer": "RisingMedia Solutions <shloooo@users.noreply.github.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "shloooo",
      "repo": "MongoStudio"
    }
  }
}